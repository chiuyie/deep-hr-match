# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: direct Postgres URL for applying migrations (Supabase -> Project Settings -> Database)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bootstrap first admin (used by npm run create-admin)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-me-8chars-min
ADMIN_NAME=Platform Admin

# Demo seed scripts (optional)
# EMPLOYER_EMAIL=employer@example.com
# DUMMY_USER_PASSWORD=DemoUser123!

# Payments: mock (default) | stripe
# mock = instant unlock for local/UAT smoke tests (no Stripe CLI needed)
# stripe = Stripe Checkout — use TEST mode keys locally (sk_test_ / whsec_)
PAYMENTS_MODE=mock

# Stripe TEST mode (required when PAYMENTS_MODE=stripe)
# API keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret from: npm run stripe:listen
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional error reporting (unlock/checkout/webhook failures)
# Create a project at https://sentry.io and paste the DSN:
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=uat

# Playwright E2E (employer unlock flow)
# Defaults use seed-dummy-users credentials when unset:
# E2E_EMPLOYER_EMAIL=employer-demo-1@deephrmatch.test
# E2E_EMPLOYER_PASSWORD=DemoUser123!
# E2E_PORT=3001
# E2E_BASE_URL=http://localhost:3001
# E2E_JOB_ID=   # optional; prepare script creates/reuses an active job
# E2E_SKIP_WEBSERVER=1  # attach to an already-running server (must be PAYMENTS_MODE=mock)
# E2E_REUSE_SERVER=1    # allow reusing a process already on E2E_PORT

# External matching engine (optional — unset uses inline placeholder)
# MATCHING_ENGINE_URL=https://matching.yourdomain.com
# MATCHING_ENGINE_API_KEY=your-shared-secret
